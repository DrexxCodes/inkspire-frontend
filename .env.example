# Fastify backend base URL (no trailing /api/v1, it is added automatically)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Firebase WEB config. These values are public by design. Used only for Firebase Authentication.
# Never put Firebase Admin credentials, Supabase service keys or database URLs in this app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The public address of this site (no trailing slash). Used for absolute links in share previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
